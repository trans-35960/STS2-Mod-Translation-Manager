{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slay the Spire 2 Mod Manager",
  "version": "0.2.2",
  "identifier": "com.sts2.modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Slay the Spire 2 Mod Manager",
        "width": 1220,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": [
      "../THIRD_PARTY_NOTICES.md",
      "../vendor/7zip/*",
      "../vendor/godot-pck-explorer-dotnet-ui-console-win-linux-mac/**/*"
    ]
  }
}
